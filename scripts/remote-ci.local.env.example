# Local-only remote-ci configuration template.
# Copy this file to scripts/remote-ci.local.env (gitignored) and fill in your
# builder host and sccache S3 credentials. Never commit the filled-in file.
export RSTORRENT_CI_HOST="root@builder.example.com"
export RSTORRENT_CI_BASE="/opt/rstorrent-ci"
export SCCACHE_ENDPOINT="http://cache.example.com:9000"
export SCCACHE_BUCKET="sccache"
export SCCACHE_REGION="us-east-1"
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
